{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/session_start.py",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/before_submit_prompt.py",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/after_agent_response.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/stop.py",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/session_end.py",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/post_tool_use.py",
        "matcher": "Shell",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "python3 ${CURSOR_PLUGIN_ROOT:-.}/hooks/pre_compact.py",
        "timeout": 10
      }
    ]
  }
}
